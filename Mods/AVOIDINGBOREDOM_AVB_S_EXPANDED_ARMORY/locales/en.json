"aea_config": "AEA Options (restart)",
"config_rebalanceVanillaWeapons": "Avb's Weapon Rebalance",
"config_rebalanceVanillaWeapons Description": "The game's weapons have a few issues that make it a little awkward to balance around. This changes the stats of all basic weapons but still aims to remain friendly to normal worldbox combat (this is explained more extensively on the mod's page)",
"config_changeRaritySystem": "Avb's Enhanced Rarity System",
"config_changeRaritySystem Description": "The rarity system for items makes more sense and is more developed.\n\nTranscendent-Maxed plus special modifier(s)\nMasterwork-Maxed with basic modifiers\nLegendary-15+ modifier levels\nEpic-10+ modifier levels\nRare-5+ modifier levels\nNormal",
"config_changeItemSprites": "Avb's Item Resprite",
"config_changeItemSprites Description": "Changes icons and mini-sprites of several items (includes both custom and base game items) [Color Consistency Ice still has an effect if this is enabled]",
"config_spriteColorConsistencyIce": "Color Consistency Ice",
"config_spriteColorConsistencyIce Description": "Shifts colors to be more consistent across all ice weapons: Zero = Dark, Inbetwen = Default in normal gameplay, One = Light",
"config_nerfSpecialModifiers": "Nerf Special Modifers",
"config_nerfSpecialModifiers Description": "Nerfs the stun, flame, and ice modifiers",
"config_creatureDefaultWeapons": "Default Creature Weapons",
"config_creatureDefaultWeapons Description": "Demons and cold ones when spawned can also have custom flame and ice weapons instead of the just the normal ones. Also makes changes to angles and plague doctors by giving their cultures a special crafting trait",
"config_royalGold": "Royal Gold",
"config_royalGold Description": "Only clan members can craft gold items (works even if gold tier items are disabled)",
"config_abundanceCM": "Abundance Common Metal Progression",
"config_abundanceCM Description": "Villages can craft increasingly higher tiers of items *that are made from common metal* once they have common metal above a certain amount (Steel 80 > Iron 60 > Gold 40 > Bronze 20)",
"config_ageCM": "Age Common Metal Progression",
"config_ageCM Description": "Villages can craft increasingly higher tiers of items *that are made from common metal* once villages have existed for a certain amount of years (Steel 80 > Iron 60 > Gold 40 > Bronze 20)",
"config_loverDefaultsCM": "Item Lover Trait Defaults",
"config_loverDefaultsCM Description": "Custom item lover traits are assigned to some species cultures by default, and some biomes can give them as well",
